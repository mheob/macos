// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            { "pattern": "^gh\\s" },
            { "pattern": "^git\\s" },
            { "pattern": "^nlx\\s" },
            { "pattern": "^nr\\s" },
          ],
        },
      },
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 16,
  "colorize_brackets": true,
  "context_servers": {
    "azure-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {
        "enable_production_credentials": false,
      },
    },
    "commands": {
      "command": "npx",
      "args": ["-y", "mcp-server-commands"],
    },
    "context7": {
      // Reads the API key from the macOS keychain (context7-api-key) and hands it over as
      // CONTEXT7_API_KEY, so it is neither in this file nor in the process list.
      "command": "/Users/ab/.local/bin/context7-mcp",
      "args": [],
    },
  },
  "disable_ai": false,
  "edit_predictions": {
    "provider": "copilot"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "languages": {
    "TSX": {
        "language_servers": [
            "typescript-ls",
            "!vtsls",
            "!typescript-language-server",
            "...",
        ],
    },
    "TypeScript": {
        "language_servers": [
            "typescript-ls",
            "!vtsls",
            "!typescript-language-server",
            "...",
        ],
    },
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
      },
      "enable_lsp_tasks": true,
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "ui_font_size": 16,
  "show_whitespaces": "boundary",
  "show_wrap_guides": true,
  "terminal": {
    "font_family": "GeistMono Nerd Font",
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "theme_overrides": {
    "Catppuccin Latte": {
      "syntax": {
        "property.comment.todo": {
          "color": "#ff8c00ff",
        },
        "property.comment.info": {
          "color": "#ff2d00ff",
        },
        "property.comment.error": {
          "color": "#ff4d00ff",
        },
      },
    },
    "Catppuccin Macchiato": {
      "syntax": {
        "property.comment.todo": {
          "color": "#ff8c00ff",
        },
        "property.comment.info": {
          "color": "#ff2d00ff",
        },
        "property.comment.error": {
          "color": "#ff4d00ff",
        },
      },
    },
  },
  "wrap_guides": [100],
}
